...@../_theme
direction: down

db: Postgres + pgvector {class: store}
user: Employee {class: actor}

query: Query path {
  class: zone
  api: Answer service {class: svc}
  qemb: Embed question {class: model}
  llm: "Generate: answer only from\nnumbered sources, cite each claim" {class: [model; new]}
  check: Citation check {class: [svc; new]}
  refuse: "Say so, link the\nclosest pages" {class: [svc; new]}
  api -> qemb
  api -> llm: question + numbered chunks
  llm -> check: answer + citations
  check -> refuse: no support {class: hot}
}
user -> query.api: question
query.api -> db: top 5, filtered
query.check -> user: answer with sources
