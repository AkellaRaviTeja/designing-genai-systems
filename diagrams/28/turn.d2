...@../_theme
shape: sequence_diagram
caller: Patient {class: actor}
stt: STT {class: ext}
ctl: Turn controller {class: svc}
llm: LLM {class: model}
tts: TTS {class: ext}

caller -> stt: "...can I move it to Thursday?"
stt -> ctl: partial transcripts while speaking
ctl -> llm: "speculative start on likely end of turn"
caller -> ctl: "silence + turn model: done (250 ms)"
stt -> ctl: final transcript (+150 ms)
llm -> ctl: "first tokens (TTFT 300 to 600 ms)"
ctl -> tts: "first sentence: Let me check Thursday."
tts -> caller: "first audio (+100 to 200 ms)"
llm -> ctl: tool call find_slots
ctl -> tts: "filler: One moment."
