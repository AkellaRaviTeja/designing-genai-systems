...@../_theme
shape: sequence_diagram
caller: Patient {class: actor}
stt: STT {class: ext}
ctl: Turn controller {class: svc}
llm: LLM {class: model}
tts: TTS {class: ext}

caller -> stt: "...can I move it to Thursday?"
stt -> ctl: partial transcripts while speaking
ctl -> llm: "speculative start on likely end of turn"
caller -> ctl: "turn model: done after 250 ms silence"
stt -> ctl: "final transcript, overlapped"
llm -> ctl: "first tokens (TTFT)"
ctl -> tts: "first sentence: Let me check Thursday."
tts -> caller: "first audio"
llm -> ctl: tool call find_slots
ctl -> caller: "pre-rendered filler: One moment."
