...@../_theme
direction: down
app: Product backend {class: svc}
w: Batch workers {class: svc}
gw: Inference gateway {
  class: zone
  auth: Keys, quotas, metering {class: svc}
  route: "Tenant and session routing" {class: [svc; new]}
  auth -> route
}
app -> gw.auth
w -> gw.auth
pool: "p5.4xlarge instances, one H100 each" {
  class: zone
  ia: "Interactive replicas\nEAGLE3 draft, 32 streams" {class: [model; new]}
  ba: "Batch replica\nFP8 KV, large batch" {class: [model; new]}
}
gw.route -> pool.ia: "restricted, by session" {class: hot}
gw.route -> pool.ba: restricted batch
api: "Hosted gpt-oss-120b API\nunrestricted tenants" {class: [ext; new]}
gw.route -> api: unrestricted
