...@../_theme
direction: down
gw: "Inference gateway\nhealth-aware routing" {class: svc}
cluster: "EKS GPU node group, p5.4xlarge" {
  class: zone
  a: "AZ a: replicas" {class: model}
  b: "AZ b: replicas\nincluding the spare" {class: [model; new]}
  nvme: "Weights on instance NVMe\nfast pod restarts" {class: [store; new]}
  ctl: "Health controller\ncordon on GPU errors" {class: [svc; new]}
  ctl -> a {class: async}
  ctl -> b {class: async}
  nvme -> a {class: offline}
}
gw -> cluster.a
gw -> cluster.b
cr: "Capacity reservation\nahead of growth" {class: [store; new]}
cr -> cluster.b {class: offline}
s3: Weights in S3 {class: store}
s3 -> cluster.nvme: copy at boot {class: offline}
