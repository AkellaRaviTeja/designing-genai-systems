...@../_theme
direction: down

clients: Callers {
  class: zone
  app: Product backend {class: svc}
  w: Batch workers {class: svc}
  q: Batch queue {class: queue}
  q -> w
}

gw: Inference gateway {
  class: zone
  auth: Keys, quotas, metering {class: svc}
  route: "Tenant, priority and\nsession routing, canary" {class: svc}
  auth -> route
}
clients.app -> gw.auth
clients.w -> gw.auth

cluster: "EKS, p5.4xlarge GPU nodes, two AZs" {
  class: zone
  ia: "Interactive replicas\n+1 spare, EAGLE3" {class: model}
  ba: "Batch replicas\nFP8 KV" {class: model}
  nvme: Instance NVMe weight copy {class: store}
  nvme -> ia {class: offline}
}
gw.route -> cluster.ia: restricted {class: hot}
gw.route -> cluster.ba: restricted batch
egress: "Egress proxy\nallow-list, no restricted IDs" {class: svc}
api: "Hosted gpt-oss-120b API" {class: ext}
gw.route -> egress: unrestricted
egress -> api

ops: Platform {
  class: zone
  reg: Model registry {class: store}
  ci: Eval gate + canary {class: svc}
  mon: "Metrics: TTFT, ITL,\nqueue, KV use, prefix hits" {class: store}
  reg -> ci
}
ops.ci -> gw.route {class: async}
cluster.ia -> ops.mon {class: async}
ops.mon -> clients.w: back-pressure {class: async}
