...@../_theme
direction: right
gpu: One H100, 80 GB, serving gpt-oss-120b {
  class: zone
  grid-columns: 3
  grid-gap: 0
  w: "Weights: 65.2 GB" {class: model; shape: rectangle; width: 652; height: 100}
  kv: "KV cache\n~10 GB\nassumed" {class: [store; new]; shape: rectangle; width: 110; height: 100; style.font-size: 17}
  rt: "Runtime\n~5 GB" {class: svc; shape: rectangle; width: 80; height: 100; style.font-size: 15}
}
