# Generated by tools/tokens.py: the diagram palette shares the site's primitives. Do not edit.
# Import with:  ...@../_theme   (see STYLE.md for what each class means)

vars: {
  d2-config: {
    layout-engine: dagre
    theme-id: 1
    pad: 28
  }
}

classes: {
  actor: {
    shape: person
    width: 56
    style: {font-size: 22; fill: "#fdfdfe"; stroke: "#262629"; stroke-width: 2; font-color: "#262629"}
  }
  svc: {
    shape: rectangle
    style: {font-size: 22; fill: "#fdfdfe"; stroke: "#262629"; stroke-width: 2; border-radius: 8; font-color: "#262629"}
  }
  model: {
    shape: hexagon
    style: {font-size: 22; fill: "#e5e8ff"; stroke: "#4e4fa1"; stroke-width: 2; font-color: "#262659"}
  }
  store: {
    shape: cylinder
    style: {font-size: 22; fill: "#d8f2ea"; stroke: "#146655"; stroke-width: 2; font-color: "#01372c"}
  }
  queue: {
    shape: queue
    style: {font-size: 22; fill: "#fbebcf"; stroke: "#7e5d1d"; stroke-width: 2; font-color: "#473100"}
  }
  ext: {
    shape: rectangle
    style: {font-size: 22; fill: "#f4f4f7"; stroke: "#909094"; stroke-width: 2; stroke-dash: 4; border-radius: 8; font-color: "#262629"}
  }
  zone: {
    style: {fill: "#f9f9fc"; stroke: "#e7e7ea"; stroke-width: 1; border-radius: 14; font-color: "#737376"; bold: false; font-size: 24}
  }
  note: {
    shape: page
    style: {fill: "#fdfdfe"; stroke: "#e7e7ea"; stroke-width: 1; font-color: "#737376"; font-size: 13}
  }
  dot: {
    shape: circle
    width: 12
    style: {fill: "#262629"; stroke: "#262629"}
  }
  new: {
    style: {stroke: "#c53e04"; stroke-width: 3; bold: true}
  }
  gone: {
    style: {opacity: 0.3; stroke-dash: 3}
  }
  async: {
    style: {font-size: 19; stroke: "#737376"; stroke-dash: 5; font-color: "#737376"}
  }
  offline: {
    style: {font-size: 19; stroke: "#146655"; stroke-dash: 2; font-color: "#146655"}
  }
  hot: {
    style: {font-size: 19; stroke: "#c53e04"; stroke-width: 3; font-color: "#c53e04"}
  }
}
